{
  "name": "foodlog",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "packageManager": "pnpm@12.16.1",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "dev:backend": "pnpm --filter @foodlog/backend dev",
    "dev:frontend": "pnpm --filter @foodlog/frontend dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "pnpm -r typecheck",
    "test": "pnpm -r test",
    "db:generate": "pnpm --filter @foodlog/backend db:generate",
    "db:migrate": "pnpm --filter @foodlog/backend db:migrate",
    "db:seed": "pnpm --filter @foodlog/backend db:seed"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "eslint": "^10.15.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript-eslint": "^8.73.0"
  }
}
