# Copy to /opt/foodlog/.env.production on the server and fill in the values.
# The file is read by docker compose (--env-file) and passed to the container.
# Never commit the filled-in file.

# Docker network used by the backend container. The database user is restricted to it.
# Pick a private range that is unused on the server, for example a /24 inside 172.16.0.0/12.
FOODLOG_SUBNET=<PRIVATE_SUBNET_CIDR>
# Port on 127.0.0.1 that nginx proxies to.
FOODLOG_PORT=3000

APP_URL=https://foodlog.herrdommel.de

# Host is the gateway address of FOODLOG_SUBNET (the first address of the subnet) as seen from the container.
DATABASE_URL=mysql://foodlog:<DATABASE_PASSWORD>@<SUBNET_GATEWAY_IP>:3306/foodlog

# 32 random bytes, base64: openssl rand -base64 32
# Losing this key makes all stored AI keys unreadable. Back it up separately from the database.
API_KEY_ENCRYPTION_KEY=<GENERATED_KEY>
# During a key rotation list the old key(s) here, comma separated, until all values were re-saved.
API_KEY_ENCRYPTION_KEY_PREVIOUS=

SMTP_HOST=<SMTP_HOST>
SMTP_PORT=587
SMTP_USER=<SMTP_USER>
SMTP_PASSWORD=<SMTP_PASSWORD>
SMTP_FROM="Foodlog I/O <foodlog@herrdommel.de>"

# Optional. Defaults to the public Open Food Facts instance.
# OPEN_FOOD_FACTS_URL=https://world.openfoodfacts.org

# Optional. Leave empty to switch the Google button off.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
