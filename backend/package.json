{
  "name": "@foodlog/backend",
  "version": "0.0.0",
  "private": true,
  "license": "AGPL-3.0-or-later",
  "type": "module",
  "scripts": {
    "dev": "tsx watch --env-file-if-exists=../.env src/server.ts",
    "build": "node build.mjs",
    "start": "node dist/server.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx --env-file-if-exists=../.env src/db/migrate.ts",
    "db:seed": "tsx --env-file-if-exists=../.env src/db/seed.ts",
    "admin:create": "tsx --env-file-if-exists=../.env src/cli/create-admin.ts",
    "invite:create": "tsx --env-file-if-exists=../.env src/cli/create-invite.ts"
  },
  "dependencies": {
    "@fastify/cookie": "^11.1.5",
    "@fastify/helmet": "^13.2.0",
    "@fastify/multipart": "^10.1.9",
    "@fastify/rate-limit": "^11.3.0",
    "argon2": "^0.45.2",
    "drizzle-orm": "^0.45.4",
    "fastify": "^5.12.8",
    "mysql2": "^3.24.6",
    "nodemailer": "^10.6.1",
    "sharp": "^0.35.5",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@foodlog/shared": "workspace:*",
    "@types/node": "^26.6.6",
    "@types/nodemailer": "^8.0.2",
    "drizzle-kit": "^0.31.11",
    "esbuild": "^0.28.2",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "vitest": "^5.1.1"
  }
}
